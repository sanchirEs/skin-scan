{
  "name": "skin-api",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side proxy for paid skin-analysis providers (YouCam by default).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "railway": "^3.17.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
